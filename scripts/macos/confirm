#!/bin/sh
# 0: approved, 2: declined, 1: no way to ask or a dialog error.
set -eu
if [ -t 0 ]; then
    printf '%s [y/N] ' "$1" >&2
    IFS= read -r reply || exit 2
    case $reply in y|Y|[yY][eE][sS]) exit 0 ;; *) exit 2 ;; esac
fi
if [ "${MINIFY_SETUP_GUI:-}" != 1 ]; then
    printf 'Approval needed: %s\n' "$1" >&2
    exit 1
fi
reply=$(/usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run argv
    activate
    try
        set choice to display dialog (item 1 of argv) with title "Dota 2 Minify" buttons {"Skip", "Continue"} default button "Continue" cancel button "Skip"
    on error number -128
        return "Skip"
    end try
    return button returned of choice
end run
APPLESCRIPT
) || exit 1
[ "$reply" = Continue ] || exit 2
